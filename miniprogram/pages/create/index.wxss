page { background-color: #F8F9FA; height: 100vh; font-family: sans-serif; }
.page-container { display: flex; flex-direction: column; height: 100vh; }

.custom-nav { width: 100%; background: #fff; }
.nav-content { display: flex; align-items: center; justify-content: space-between; height: 44px; padding: 0 30rpx;}
.nav-title { font-size: 34rpx; font-weight: bold; }
.nav-left, .nav-right { width: 80rpx; }
.circle-back { width: 60rpx; height: 60rpx; background: #F2F2F7; border-radius: 50%; display: flex; justify-content: center; align-items: center; font-weight: bold; }

.form-scroll { flex: 1; padding: 30rpx; padding-bottom: calc(160rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }

/* 头部图标与按钮 */
.icon-lib-section { display: flex; justify-content: space-between; align-items: center; margin-bottom: 40rpx; }
.icon-selector { display: flex; align-items: center; gap: 30rpx; }
.selected-icon-ring { padding: 4rpx; border: 4rpx solid #FFE4E1; border-radius: 50%; }
.icon-big { width: 110rpx; height: 110rpx; border-radius: 50%; display: flex; justify-content: center; align-items: center; position: relative; }
.gray-icon { background: #E5E5EA; color: #fff; font-size: 40rpx; font-weight: bold; }
.icon-mock { font-size: 44rpx; font-weight: bold; }
.camera-badge { position: absolute; bottom: -4rpx; right: -4rpx; width: 36rpx; height: 36rpx; background: #000; border-radius: 50%; display: flex; justify-content: center; align-items: center; border: 4rpx solid #fff; }
.lib-btn { border: 2rpx solid #34C759; color: #34C759; padding: 12rpx 24rpx; border-radius: 30rpx; font-size: 26rpx; font-weight: bold; }

/* 通用卡片样式 */
.card-box { background: #fff; border-radius: 24rpx; padding: 30rpx; margin-bottom: 30rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02); }

/* 输入区卡片 */
.input-row { display: flex; justify-content: space-between; align-items: center; border-bottom: 2rpx solid #F2F2F7; padding-bottom: 30rpx; margin-bottom: 30rpx; }
.title-input { flex: 1; font-size: 34rpx; font-weight: bold; }
.cat-picker { font-size: 28rpx; color: #8E8E93; }
.add-desc { font-size: 26rpx; color: #8E8E93; }

/* 评分卡片 */
.card-score { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 30rpx; }
.score-header { display: flex; align-items: center; gap: 20rpx; }
.segment-ctrl { display: flex; background: #F2F2F7; border-radius: 12rpx; padding: 4rpx; }
.seg-item { padding: 12rpx 20rpx; font-size: 26rpx; color: #8E8E93; border-radius: 10rpx; transition: all 0.2s;}
.seg-item.active { background: #A2FA96; color: #000; font-weight: bold; }
.stars-preview { display: flex; align-items: center; gap: 10rpx; font-size: 36rpx; }
.gray-face { color: #8E8E93; }
.gray-star { color: #C7C7CC; }

/* 设置列表卡片 */
.card-settings { padding: 10rpx 30rpx; }
.set-item { display: flex; justify-content: space-between; align-items: center; padding: 30rpx 0; }
.set-label { font-size: 30rpx; color: #333; display: flex; align-items: center; gap: 10rpx; }
.set-value { font-size: 28rpx; color: #8E8E93; }
.hint { color: #C7C7CC; }
.set-divider { height: 2rpx; background: #F2F2F7; border-style: dashed; }
.plan-tag-wrap { display: flex; align-items: center; gap: 10rpx; }
.plan-tag { background: #34C759; color: #fff; font-size: 20rpx; padding: 4rpx 8rpx; border-radius: 6rpx; }

/* 底部按钮 */
.bottom-bar { position: fixed; bottom: 0; left: 0; width: 100%; background: #fff; padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom)) 40rpx; box-sizing: border-box; }
.btn-add { width: 100%; height: 88rpx; background: #8AFA84; color: #000; font-size: 32rpx; font-weight: bold; display: flex; justify-content: center; align-items: center; border-radius: 44rpx; }