/* pages/import/index.wxss */
page {
  background-color: #FFFFFF;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* --- 自定义导航栏 --- */
.custom-nav {
  width: 100%;
  background-color: #FFFFFF;
  z-index: 99;
}

.nav-content {
  height: 44px; /* 微信标准导航栏高度 */
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  position: relative;
}

.nav-left {
  width: 100rpx;
}

/* --- 放大返回图标 --- */
.back-btn {
  width: 80rpx; /* 增大点击热区，方便用户点击 */
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.chevron-left {
  width: 24rpx;
  height: 24rpx;
  /* 调整边框粗细和颜色 */
  border-top: 5rpx solid #34C759; 
  border-left: 5rpx solid #34C759;
  /* 旋转 45 度形成箭头 */
  transform: rotate(-45deg);
  /* 增加微小的圆角，消除尖锐感，完美模拟 iOS 原生圆润箭头 */
  border-top-left-radius: 4rpx; 
  margin-left: 10rpx; /* 微调位置 */
}
.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #000000;
}

.nav-right {
  width: 100rpx;
  display: flex;
  justify-content: flex-end;
}

.btn-confirm {
  font-size: 28rpx;
  font-weight: bold;
  background-color: #F2F2F7;
  color: #D1D1D6;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  transition: all 0.2s;
}

/* 确定按钮激活态 */
.btn-confirm.active {
  background-color: #34C759;
  color: #FFFFFF;
}

/* --- Tabs --- */
.tab-scroll {
  width: 100%;
  border-bottom: 1rpx solid rgba(0,0,0,0.05);
}

.tab-list {
  display: inline-flex;
  padding: 20rpx 10rpx;
}

.tab-item {
  padding: 10rpx 30rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #8E8E93; /* 默认灰色 */
  white-space: nowrap;
}

.tab-active {
  color: #34C759; /* 选中绿色 */
}

/* --- 网格列表 --- */
.grid-scroll {
  flex: 1;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.grid-container {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  row-gap: 50rpx;
  padding: 40rpx 20rpx 20rpx 20rpx; /* 底部间距调小 */
}
.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.icon-box {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  border: 4rpx solid; /* 边框颜色由内联样式动态控制 */
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 16rpx;
  position: relative;
  overflow: hidden;
}

/* 模拟的文字图标 */
.icon-mock {
  font-size: 40rpx;
  font-weight: bold;
}

/* 选中时的遮罩 */
.selected-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.06);
  display: flex;
  justify-content: flex-end;
  align-items: flex-end;
  padding: 6rpx;
  box-sizing: border-box;
}

.item-title {
  font-size: 26rpx;
  color: #333333;
}

/* --- 底部悬浮栏 (重构垂直居中) --- */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  /* 去掉 fixed height，让它自适应内容 + 安全距离 */
  background-color: #FFFFFF;
  display: flex;
  justify-content: space-between;
  align-items: center; /* 核心：让文字和按钮绝对垂直居中对齐 */
  
  /* 上:20 左右:40 下: 20+系统底部小黑条高度 */
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom)) 40rpx; 
  box-sizing: border-box;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.04);
}
.count-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #000000;
  /* 去掉之前的 line-height */
}

/* 确定按钮 */
.btn-confirm {
  font-size: 28rpx;
  font-weight: bold;
  background-color: #F2F2F7; 
  color: #C7C7CC; 
  padding: 14rpx 40rpx; /* 用 padding 撑开高度，不再写死 height，更加灵活 */
  border-radius: 32rpx;
  transition: all 0.3s ease; 
}

.count-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #000000;
}/* --- 网格列表新增样式 --- */
.disabled-item {
  opacity: 0.6; /* 整体半透明变淡 */
}

.disabled-item .item-title {
  color: #C7C7CC; /* 文字变灰 */
}

/* 已添加的遮罩提示 */
.existing-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(242, 242, 247, 0.8); /* 浅灰底 */
  display: flex;
  justify-content: center;
  align-items: center;
}

.existing-txt {
  font-size: 24rpx;
  font-weight: bold;
  color: #8E8E93;
}