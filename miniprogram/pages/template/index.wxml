<view class="page-container">
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-content">
      <view class="nav-left" bindtap="onBack">
        <view class="back-btn"><view class="chevron-left"></view></view>
      </view>
      <view class="nav-title">选择模板</view>
      <view class="nav-right" bindtap="onImportTap">
        <icon type="search" size="18" color="#8E8E93" style="margin-right: 10rpx;"></icon>
        <text class="import-txt">导入</text>
      </view>
    </view>
  </view>

  <scroll-view class="tab-scroll" scroll-x show-scrollbar="{{false}}">
    <view class="tab-list">
      <view class="tab-item {{currentCategory === item ? 'tab-active' : ''}}" 
            wx:for="{{categories}}" wx:key="*this" 
            bindtap="onTabClick" data-cat="{{item}}">
        {{item}}
      </view>
    </view>
  </scroll-view>

  <scroll-view class="grid-scroll" scroll-y>
    <view class="grid-container">
      <view class="grid-item" wx:for="{{listData}}" wx:key="title" bindtap="onItemClick" data-index="{{index}}">
        <view class="icon-box" style="background-color: {{item.hexColor}}20; border: 4rpx solid {{item.hexColor}};">
          <text class="icon-mock" style="color: {{item.hexColor}};">{{item.title[0]}}</text>
        </view>
        <text class="item-title">{{item.title}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="bottom-bar">
    <view class="btn-custom" bindtap="onCustomAdd">自定义添加</view>
  </view>
</view>