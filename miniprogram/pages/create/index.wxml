<view class="page-container">
<view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-content">
      
      <view class="nav-left" bindtap="onBack">
        <view class="back-btn">
          <view class="chevron-left"></view>
        </view>
      </view>
      
      <view class="nav-title">创建目标</view>
      
      <view class="nav-right"></view>
    </view>
  </view>

  <scroll-view class="form-scroll" scroll-y>
    
    <view class="icon-lib-section">
      <view class="icon-selector">
        <view class="selected-icon-ring">
          <view class="icon-big" style="background-color: {{hexColor}}20;">
            <text class="icon-mock" style="color: {{hexColor}};">{{title[0] || '?'}}</text>
            <view class="camera-badge"><icon type="camera" size="10" color="#fff"/></view>
          </view>
        </view>
        <view class="icon-big gray-icon"><text>文</text></view>
      </view>
      <view class="lib-btn">目标库 〉</view>
    </view>

    <view class="card-box card-input">
      <view class="input-row">
        <input class="title-input" placeholder="输入目标名称" value="{{title}}" bindinput="onTitleInput" />
        <picker mode="selector" range="{{categoriesList}}" bindchange="onCategoryChange">
          <view class="cat-picker">{{category}} ∨</view>
        </picker>
      </view>
      <view class="add-desc">+ 添加描述</view>
    </view>

  <view class="bottom-bar">
    <view class="btn-add" bindtap="onAdd">添加</view>
  </view>
  </scroll-view>


</view>