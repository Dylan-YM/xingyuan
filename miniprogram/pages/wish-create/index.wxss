page { background-color: #FFFFFF; font-family: -apple-system, sans-serif; }
.page-container { display: flex; flex-direction: column; height: 100vh; }

.nav-content { display: flex; align-items: center; justify-content: space-between; height: 44px; padding: 0 30rpx;}
.nav-left, .nav-right { width: 140rpx; display: flex; align-items: center; }
.nav-right { justify-content: flex-end; }
.nav-title { flex: 1; text-align: center; font-size: 34rpx; font-weight: bold; }
.back-btn { width: 60rpx; height: 100%; display: flex; align-items: center; }
.chevron-left { width: 20rpx; height: 20rpx; border-top: 5rpx solid #000; border-left: 5rpx solid #000; transform: rotate(-45deg); border-top-left-radius: 4rpx;}
.import-txt { font-size: 28rpx; color: #8E8E93; }

.form-scroll { flex: 1; padding: 40rpx; box-sizing: border-box; }

.header-row { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 50rpx; }
.photo-placeholder { width: 100rpx; height: 100rpx; background: #F2F2F7; border-radius: 20rpx; display: flex; justify-content: center; align-items: center; }
.lib-capsule { background: #F0FDF4; color: #34C759; padding: 12rpx 24rpx; border-radius: 30rpx; font-size: 26rpx; font-weight: 500; border: 1rpx solid #DCFCE7; }

/* --- 核心表单组 --- */
.main-form-group { margin-bottom: 60rpx; }

.name-row { display: flex; align-items: center; border-bottom: 1rpx solid #F2F2F7; padding-bottom: 30rpx; margin-bottom: 40rpx; }
.name-input { flex: 1; font-size: 38rpx; font-weight: bold; }
.unit-picker { font-size: 32rpx; color: #8E8E93; padding-left: 20rpx; border-left: 2rpx solid #F2F2F7; margin-left: 20rpx; }

.step-item { display: flex; justify-content: space-between; align-items: center; margin-bottom: 40rpx; }
.label-group { display: flex; align-items: center; font-size: 32rpx; color: #333; font-weight: 500;}
.star-mini { margin-left: 10rpx; font-size: 28rpx; }
.label { font-size: 32rpx; color: #333; font-weight: 500; }
.step-val { width: 60rpx; text-align: center; font-size: 32rpx; font-weight: bold; }
.stepper {
  display: flex;
  align-items: center;
  background: #F2F2F7;
  border-radius: 12rpx;
  padding: 4rpx;
}

.step-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 36rpx;
  color: #333;
}

/* 💡 新增 input 样式 */
.step-input {
  width: 80rpx;      /* 宽度根据需要调整 */
  height: 60rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #000;
}
/* 描述输入框 (放在数量下方) */
.desc-row { padding-top: 10rpx; }
.desc-input { font-size: 30rpx; color: #333; width: 100%; }
.desc-placeholder { color: #C7C7CC; }

/* --- 底部列表 --- */
.settings-list { border-top: 1rpx dashed #F2F2F7; padding-top: 40rpx; }
.set-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 40rpx; }
.set-label { font-size: 30rpx; color: #333; }
.set-value { font-size: 28rpx; color: #C7C7CC; }

/* --- 提交按钮 --- */
.bottom-area { padding: 40rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.btn-submit { height: 100rpx; background: #C9F4A7; color: #34C759; border-radius: 50rpx; display: flex; justify-content: center; align-items: center; font-size: 34rpx; font-weight: bold; }
/* --- 新增：小计预览卡片样式 --- */
.summary-card {
    background: #F8F9FA;
    border-radius: 20rpx;
    padding: 24rpx;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40rpx;
  }
  .sum-left { display: flex; align-items: center; }
  .sum-icon { 
    width: 80rpx; height: 80rpx; 
    border-radius: 16rpx; 
    display: flex; justify-content: center; align-items: center; 
    font-size: 44rpx; margin-right: 20rpx; 
  }
  .sum-info { display: flex; flex-direction: column; }
  .sum-title { font-size: 30rpx; font-weight: bold; color: #333; margin-bottom: 6rpx; }
  .sum-detail { font-size: 24rpx; color: #8E8E93; }
  
  .sum-right { display: flex; align-items: baseline; }
  .sum-total-label { font-size: 24rpx; color: #8E8E93; margin-right: 8rpx; }
  .sum-total-star { font-size: 34rpx; font-weight: 800; color: #FF9500; }