/* pages/index/index.wxss */
page {
  background-color: #F8F8F9; /* 浅灰底色 */
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

.page-container {
  /* padding-bottom: 160rpx;  */
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* === 顶部模块 === */
.header-section {
  background-color: #FFFFFF;
  border-bottom-left-radius: 32rpx;
  border-bottom-right-radius: 32rpx;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
}
.user-row {
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  margin-bottom: 40rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.user-text-group {
  display: flex;
  flex-direction: column;
}

.name-line {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.name {
  font-size: 40rpx;
  font-weight: 800;
  color: #000000;
  margin-right: 16rpx;
}

.score-line {
  display: flex;
  align-items: center;
}
.avatar-img {
  width: 100%;
  height: 100%;
}

.name {
  font-size: 44rpx;
  font-weight: 800;
  color: #000000;
  margin-right: 16rpx;
}

.btn-clear {
  background-color: #0000FF;
  color: #FFFFFF;
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 500;
}

.score-info {
  display: flex;
  align-items: center;
}

.score-star {
  color: #FFCC00;
  font-size: 40rpx;
  margin-right: 8rpx;
}

.score-num {
  color: #FF9500;
  font-size: 40rpx;
  font-weight: 900;
}

/* === 日历模块 === */
.calendar-scroll {
  width: 100%;
  white-space: nowrap;
}

.calendar-flex {
  display: inline-flex;
  padding: 0 30rpx;
}

.date-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 110rpx;
  height: 120rpx;
  margin: 0 10rpx;
  border-radius: 20rpx;
  border: 4rpx solid transparent; /* 预留边框位置防止跳动 */
}

.d-num {
  font-size: 32rpx;
  font-weight: 500;
  color: #8E8E93;
  margin-bottom: 8rpx;
}

.d-week {
  font-size: 24rpx;
  color: #8E8E93;
}

/* 选中态 (今天) */
.date-box.active {
  border-color: #34C759;
  background-color: #F0FDF4; /* 浅绿背景 */
}

.date-box.active .d-num,
.date-box.active .d-week {
  color: #34C759;
  font-weight: 600;
}

/* === 列表模块 === */
.list-section {
  padding: 0 32rpx;
  margin-top: 10rpx;
}

.category-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0; /* ⬅️ 把这里改成 20rpx 甚至 16rpx，视觉上就会紧凑很多 */
}

.cat-title-group {
  display: flex;
  align-items: flex-end;
}

.cat-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #000000;
  margin-right: 12rpx;
}

.cat-count {
  font-size: 30rpx;
  color: #B0B0B5;
  margin-bottom: 2rpx;
}

.cat-arrow {
  width: 16rpx;
  height: 16rpx;
  border-right: 4rpx solid #C7C7CC;
  border-bottom: 4rpx solid #C7C7CC;
  transition: transform 0.2s;
}
.cat-arrow.down { transform: rotate(45deg); }
.cat-arrow.up { transform: rotate(225deg); }

/* === 任务卡片 === */
.task-list {
  margin-bottom: 10rpx;
}

.task-card {
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 30rpx 36rpx;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03); /* 微弱的呼吸阴影 */
}

.card-left {
  display: flex;
  align-items: center;
}

.icon-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.icon-face {
  color: rgba(255, 255, 255, 0.4); /* 半透明笑脸 */
  font-size: 40rpx;
}

.task-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #000000;
}

.card-right {
  display: flex;
  align-items: center;
}

.gray-face {
  font-size: 44rpx;
  color: #E5E5EA;
  margin-right: 20rpx;
}

.star-group {
  display: flex;
}

.star {
  font-size: 44rpx;
  margin-left: 12rpx;
}

.star.yellow { color: #FFCC00; }
.star.gray { color: #E5E5EA; }
.card-right {
  display: flex;
  align-items: center;
}

/* --- 右侧笑脸状态 --- */
.status-face {
  font-size: 44rpx;
  margin-right: 20rpx;
}
.face-gray { color: #E5E5EA; }
.face-red { color: #FF3B30; } /* 批评特有红色笑脸 */

/* --- 星星状态 --- */
.star-group {
  display: flex;
}
.star {
  font-size: 44rpx;
  margin-left: 12rpx;
  transition: transform 0.1s ease;
}
.star-yellow { color: #FFCC00; } /* 常规选中黄色 */
.star-red { color: #FF3B30; }    /* 批评选中红色 */
.star-gray { color: #E5E5EA; }   /* 未选中灰色 */

/* 给点亮的星星加一个小点击动画（对应你 Swift 里的 transform） */
.star-yellow:active, .star-red:active {
  transform: scale(1.2);
}
/* === 悬浮添加按钮 === */
/* === 悬浮添加按钮 === */
.fab-add {
  position: fixed;
  
  /* 核心修改：
     10rpx 是你要求的基础间距
     env(safe-area-inset-bottom) 是苹果手机底部安全区（小黑条）的高度
  */
  bottom: calc(10rpx + env(safe-area-inset-bottom)); 

  left: 50%;
  transform: translateX(-50%);
  width: 120rpx;
  height: 120rpx;
  background-color: #000000;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  z-index: 99; /* 确保在最上层 */
}
.fab-icon {
  color: #FFFFFF;
  font-size: 64rpx;
  font-weight: 300;
  margin-top: -6rpx;
}
.half-screen-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 900;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}
.half-screen-mask.show {
  opacity: 1;
  visibility: visible;
}

.half-screen-menu {
  position: fixed;
  bottom: 0; left: 0; width: 100%;
  background-color: #F8F9FA;
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom)) 40rpx;
  box-sizing: border-box;
  z-index: 901;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
}
.half-screen-menu.show {
  transform: translateY(0);
}

.menu-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 40rpx; }
.menu-title { font-size: 36rpx; font-weight: bold; color: #000; }
.date-picker-mini { font-size: 26rpx; color: #8E8E93; }

.ai-input-box { display: flex; align-items: center; background-color: #FFFFFF; border-radius: 20rpx; padding: 10rpx 10rpx 10rpx 30rpx; margin-bottom: 40rpx; }
.ai-input-box input { flex: 1; height: 70rpx; font-size: 28rpx; }
.ai-placeholder { color: #C7C7CC; }
.ai-btn { background-color: #F2F2F7; color: #34C759; font-size: 26rpx; font-weight: bold; padding: 16rpx 24rpx; border-radius: 16rpx; display: flex; align-items: center; }
.ai-icon { margin-right: 8rpx; font-size: 30rpx; }

.menu-subtitle { font-size: 32rpx; font-weight: bold; color: #000; display: block; margin-bottom: 30rpx; }
.menu-grid { display: flex; justify-content: space-between; margin-bottom: 60rpx; }
.menu-item { display: flex; flex-direction: column; align-items: center; flex: 1; }
.menu-icon-box { width: 120rpx; height: 120rpx; background-color: #FFFFFF; border-radius: 30rpx; display: flex; justify-content: center; align-items: center; margin-bottom: 16rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.03); }
.m-icon { font-size: 50rpx; color: #000; }
.menu-item text { font-size: 26rpx; color: #333; }

.close-area { display: flex; justify-content: center; }
.close-btn-circle { width: 70rpx; height: 70rpx; background-color: #E5E5EA; color: #8E8E93; border-radius: 50%; display: flex; justify-content: center; align-items: center; font-size: 44rpx; font-weight: 300; line-height: 1; }